# Supabase — project uqcbziwdgbnzehipzjxp.
#
# The URL is not a secret (it ships to the browser via NEXT_PUBLIC_), so it is
# filled in here. The two keys are NOT: copy them from
# Supabase → Project Settings → API into .env.local, which is gitignored.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. Server-side only — it must
# never reach a client component, and never go in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://uqcbziwdgbnzehipzjxp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (v1) — added in step 05
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
#
# REQUIRED IN PRODUCTION. /api/mp/webhook is a public endpoint that hands out
# paid tiers, so it refuses every request it cannot verify. With this unset the
# webhook returns 401 and nobody gets what they paid for — which is the correct
# failure, but check here first if upgrades stop landing.
# MERCADOPAGO_WEBHOOK_SECRET=
#
# Local development only: accept UNSIGNED webhooks (e.g. replaying a payload by
# hand) when no secret is set. Inert when NODE_ENV=production, by construction.
# MP_ALLOW_UNSIGNED_WEBHOOK=true

# Resend — transactional email (contact form, receipts) AND, via Supabase
# custom SMTP, all auth emails (signup confirm, password reset, magic link).
# See docs/email/supabase-auth-setup.md for the Supabase-side wiring.
RESEND_API_KEY=
# Verified sender. Defaults to "Chalyb <noreply@chalyb.com>" if unset.
# Keep identical to the sender configured in Supabase → Auth → SMTP.
# RESEND_FROM_EMAIL=Chalyb <noreply@chalyb.com>
# Where the public /contacto form lands. Defaults to RESEND_FROM_EMAIL.
# RESEND_CONTACT_TO=

# Public origin — THE canonical one. Used for Mercado Pago back_urls and
# notification_url, and for absolute links in server-sent emails. In production
# set this to https://chalyb.com on Vercel. Get it wrong and MP checkout
# silently points customers back at localhost.
# (Auth email links are separate: they use the Supabase Site URL + redirect
# allowlist, configured in the Supabase dashboard.)
#
# NEXT_PUBLIC_SITE_URL was the old name for this and is still read as a
# fallback. Don't set both.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Command Center — comma-separated list of emails that are ALWAYS forced to SUPER_ADMIN
# regardless of stored role. The first-user-is-root backstop.
# Fill in with YOUR address before first run — whoever is listed here is
# forced to SUPER_ADMIN on every request.
SUPER_ADMIN_EMAILS=you@example.com

# Engines — per-engine secrets. Set the same values in Vercel, or provisioning
# and SSO launches fail.
#
# *_ADMIN_TOKEN  Bearer token the engine's /api/admin endpoints accept.
#                Must equal CHALYB_ADMIN_TOKEN on the engine side.
# *_SSO_SECRET   HMAC secret used to sign the launch token.
#                Must equal CHALYB_SSO_SECRET on the engine side.
# CHALYBCLIP_ADMIN_TOKEN=
# CHALYBCLIP_SSO_SECRET=
# CHALYBOBS_ADMIN_TOKEN=
# CHALYBOBS_SSO_SECRET=
# CHALYBCRYPTO_ADMIN_TOKEN=
# CHALYBCRYPTO_SSO_SECRET=

# Upstash Redis (optional but recommended in production) — backs the shared
# rate limiter for the public /contacto form. Without it the limiter falls back
# to a per-instance in-memory bucket, which a burst across serverless instances
# walks straight past. Create a database at console.upstash.com and copy the
# REST url + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
