# Supabase — project uqcbziwdgbnzehipzjxp.
#
# The URL is not a secret (it ships to the browser via NEXT_PUBLIC_), so it is
# filled in here. The two keys are NOT: copy them from
# Supabase → Project Settings → API into .env.local, which is gitignored.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. Server-side only — it must
# never reach a client component, and never go in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://uqcbziwdgbnzehipzjxp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — Pro/VIP monthly subscriptions and one-off token packs.
#
# Pro and VIP are Mercado Pago SUBSCRIPTIONS (the /preapproval API): the user
# enters the card in a form inside the app (Checkout Bricks), Mercado Pago
# tokenises it, and the subscription is created already authorised; it then
# charges every month until cancelled. Token packs are Orders API payments
# from the same card form. The webhook keeps both in sync afterwards.
#
# A checkout only starts when BOTH the access token and the webhook secret are
# set (src/lib/payments/mp-config.ts): without the secret /api/mp/webhook
# rejects every notification and a paid plan would never be credited. Until
# then /app/subscription says so and no checkout is started. Set the same
# three on Vercel; the webhook secret must also match the one in the Mercado
# Pago dashboard, with the topics "Orders", "Suscripciones" and "Pagos" enabled.
# The public key initialises the card form (Checkout Bricks) in the browser;
# it is not a secret but the checkout will not render without it.
# Full setup: docs/payments/mercadopago.md.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
# Which Mercado Pago environment this deployment uses: prod | test. Default:
# prod on Vercel Production, test everywhere else. The three values above
# must be the pair for that environment (prod: both APP_USR-).
# MP_ENV=test
# Required when MP_ENV=test: the test buyer's email, sent as payer_email on
# every preapproval and order instead of the signed-in user's.
# MP_TEST_PAYER_EMAIL=
# Optional: the access token must belong to this seller id (GET /users/me).
# MP_EXPECTED_SELLER_ID=

# Resend — transactional email (contact form, receipts) AND, via Supabase
# custom SMTP, all auth emails (signup confirm, password reset, magic link).
# See docs/email/supabase-auth-setup.md for the Supabase-side wiring.
RESEND_API_KEY=
# Verified sender. Defaults to "Chalyb <noreply@chalyb.com>" if unset.
# Keep identical to the sender configured in Supabase → Auth → SMTP.
# RESEND_FROM_EMAIL=Chalyb <noreply@chalyb.com>
# Where the public /contacto form lands. Defaults to RESEND_FROM_EMAIL.
# RESEND_CONTACT_TO=

# The hub's public origin. ONE name for all of it: Mercado Pago back_urls and
# notification_url, absolute links in server-sent emails, robots.txt and the
# sitemap. In production set this to https://chalyb.com on Vercel.
# (Auth email links use the Supabase Site URL + redirect allowlist, configured
# in the Supabase dashboard — a separate setting.)
#
# NEXT_PUBLIC_SITE_URL is the old name and is still read as a fallback; set
# NEXT_PUBLIC_APP_URL and remove it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Command Center — comma-separated list of emails that are ALWAYS forced to SUPER_ADMIN
# regardless of stored role. The first-user-is-root backstop.
#
# Put YOUR OWN address here in .env.local (this file is the committed example,
# so it carries a placeholder — anyone whose address is listed here becomes a
# super admin on the deployment that uses it).
SUPER_ADMIN_EMAILS=you@example.com

# Engines — per-engine secrets. Set the same values in Vercel, or provisioning
# and SSO launches fail.
#
# *_ADMIN_TOKEN  Bearer token the engine's /api/admin endpoints accept.
#                Must equal CHALYB_ADMIN_TOKEN on the engine side.
# *_SSO_SECRET   HMAC secret used to sign the launch token.
#                Must equal CHALYB_SSO_SECRET on the engine side.
# CHALYBCLIP_ADMIN_TOKEN=
# CHALYBCLIP_SSO_SECRET=
# CHALYBOBS_ADMIN_TOKEN=
# CHALYBOBS_SSO_SECRET=
# CHALYBCRYPTO_ADMIN_TOKEN=
# CHALYBCRYPTO_SSO_SECRET=

# Pricing (src/config/pricing.ts; PRICING-CARDS-SPEC). Amounts live in code,
# never here.
# Prices are totals, IVA included. The default is true IN CODE; set it
# explicitly anyway in every Vercel environment (OPS-17).
PRICES_INCLUDE_IVA=true
# How savings / discount percentages round: floor (default) | round.
# PCT_ROUNDING=floor
# The struck $1,662 next to Pro mensual (Law §16.5). Off unless the flag AND
# all four values are set, and only until REFERENCE_PRICE_UNTIL (ISO date,
# checked on the server). Owner item O-3 / OPS-21.
# SHOW_REFERENCE_PRICE=false
# REFERENCE_PRICE_SITE=
# REFERENCE_PRICE_DATE=
# REFERENCE_PRICE_PROMO_END=
# REFERENCE_PRICE_UNTIL=
# USD prices and US/CA tax footers (display only; MXN everywhere while off).
# USD_MARKET_ENABLED=false

# 7-day trial (WS-3). The day-0 charge notice is always on.
# Optional "Mañana termina tu prueba gratis" email + banner on day 6 (O-11).
# TRIAL_DAY6_REMINDER=false
# Pausing a preapproval during its trial is unverified at Mercado Pago
# (OPS-14). Until true, the hold rule records the hold and alerts an admin
# instead of pausing (O-6, O-16).
# MP_PAUSE_IN_TRIAL_VERIFIED=false

# Plan cards (WS-4). "Más popular" on Pro is a factual claim: only with the
# sales data behind it (O-13 / OPS-22). Off: "Recomendado".
# PRO_BADGE_MOST_POPULAR=false

# Paid checkout without the trial (WS-5, V-1): annual plans, VIP anual, the
# paid consent path and plan changes. Refused until the legal texts, the
# seller identity, CONSENT_ENCRYPTION_KEY and CRON_SECRET are set. The 7-day
# trial needs this AND TRIAL_FLOW_ENABLED. Order (OPS-10): LEGAL_PUBLISH →
# PAID_CHECKOUT_ENABLED → TRIAL_FLOW_ENABLED.
# PAID_CHECKOUT_ENABLED=false
# VIP anual wherever annual plans are offered (still needs paid checkout).
# VIP_YEAR_ENABLED=true

# Price increase for existing subscribers (WS-6, owner O-2). Off: nothing is
# sent and grandfathered subscribers keep renewing at their amount.
# PRICE_INCREASE_NOTICES_ENABLED=false
# Without acceptance: gratis (Términos §5.3 as written) | keep_old.
# PRICE_INCREASE_NO_ANSWER=gratis
# Changing a running preapproval's amount is unverified at MP (OPS-14).
# Until true, an accepted increase becomes an admin item, never a charge.
# MP_PREAPPROVAL_AMOUNT_PUT_VERIFIED=false

# Pro Lealtad (WS-7). Off: no toggle option, no route, no copy. It can't
# ship until lowering a running preapproval's amount is verified at MP
# (MP_PREAPPROVAL_AMOUNT_PUT_VERIFIED, OPS-14/OPS-24). MXN only.
# LEALTAD_ENABLED=false
# Withdraw it for new customers; existing schedules continue.
# LEALTAD_OPEN_TO_NEW_CUSTOMERS=true
# Optional days to resume the step after cancelling (O-15). 0 = off.
# LEALTAD_RETURN_WINDOW_DAYS=0

# Refunds and chargebacks (WS-8, Términos de Suscripción §7 and §10). A
# dispute alone never changes an account. With measures off, the system
# records, triages, builds the evidence and queues the 10-business-day
# notice for an admin, and never restricts, closes or asks for prepayment.
# Both flags wait for the attorney (OPS-10, REVISION S.3).
# CHARGEBACK_MEASURES_ENABLED=false
# CHARGEBACK_REFUSE_NEW_SUBSCRIPTIONS=false
# Days unpaid after a restriction before closing (Términos §10.6(b), min 30).
# CHARGEBACK_CLOSE_AFTER_DAYS=30

# Mi perfil (WS-9 C, FIX-3 D-F3-5): the three notification switches. Off
# until a sender reads notify_critical / notify_daily / notify_viral.
# PROFILE_NOTIFICATION_PREFS=false

# 7-day trial (WS-3). Needs PAID_CHECKOUT_ENABLED and everything it needs.
# TRIAL_FLOW_ENABLED=false
# The trial picker offers the monthly and the annual version of the chosen
# plan (the trial is on any plan, first time only; C9: annual is never
# preselected in checkout).
# TRIAL_PLAN_CHOICE_ENABLED=true
# Quebec: trial and paid plans blocked until a French version exists (§11).
# QUEBEC_PAID_BLOCK=true

# Legal (WS-12, OPS-10). LEGAL_PUBLISH only takes effect once every current
# legal version is marked published and no [BRACKET] placeholder is left
# (pnpm legal:hash, pnpm test:legal --strict). Then, in order: LEGAL_PUBLISH
# → PAID_CHECKOUT_ENABLED → TRIAL_FLOW_ENABLED.
# LEGAL_PUBLISH=false
# Seller identity shown before paying (art. 76 Bis fr. III). Paid checkout
# is refused while any is empty.
# LEGAL_ENTITY_NAME=
# LEGAL_ENTITY_RFC=
# LEGAL_ENTITY_ADDRESS=
# LEGAL_ENTITY_PHONE=
# LEGAL_ENTITY_EMAIL=
# LEGAL_ENTITY_HOURS=
# LEGAL_ENTITY_COMPLAINTS=
# Encrypts IP and user agent in consent_events (32 bytes, base64). Required
# for paid checkout.
# CONSENT_ENCRYPTION_KEY=
# Bearer secret for /api/cron/billing (daily 15:00 UTC, OPS-7). Required for
# paid checkout.
# CRON_SECRET=
# Resend delivered/bounced webhooks (/api/resend/webhook, OPS-12): the
# notice hold rule depends on them.
# RESEND_WEBHOOK_SECRET=
# test:legal only: scan a live deployment's legal pages instead of the
# registry (e.g. a preview URL).
# LEGAL_BASE_URL=

# What Pro includes (D7, owner O-9). Server entitlement: every active tool
# on paid plans. Copy only claims "todas las herramientas" once the owner
# aligns TIER_CAPS and the terms (allToolsClaimAllowed in flags.ts).
# PRO_INCLUDES_ALL_TOOLS=true
# Gratis can make clips (watermarked).
# FREE_INCLUDES_CLIPS=true
# D8: the Clips app enforces Gratis in SD and no live-stream clips on Gratis.
# Off (today): the cards don't promise those two limits.
# PLAN_FEATURE_CLIP_LIMITS_ENFORCED=false
# CFDI (facturas) offered in the UI only once a PAC is set up (OPS-17).
# CFDI_ENABLED=false
# The owner confirmed the "minutos" support promise (Q16). Off: "lo antes
# posible".
# SUPPORT_SLA_CONFIRMED=false

# Canonical origin for URLs, sitemaps and consent records (default
# https://www.chalyb.com).
# NEXT_PUBLIC_CANONICAL_ORIGIN=https://www.chalyb.com

# Local e2e only, never on a deployment.
# Mock tool adapters in a production build (previews and e2e).
# E2E_USE_MOCK_ADAPTERS=
# Treat the legal drafts as published so "flow on" e2e can run the trial;
# honored only with mock adapters allowed.
# E2E_LEGAL_DRAFTS_AS_PUBLISHED=

# Owner panel cost metrics (admin only). Organization Admin API key, server
# side only; without it the panel shows estimated costs.
# ANTHROPIC_ADMIN_KEY=
# USD → MXN rate for those costs (default 18).
# ANTHROPIC_USD_TO_MXN=18

# How the hub runs each tool, per slug (rebuild P3): off (default: the card
# opens the tool's own app over SSO) | a (the hub renders the flow through
# the tool's job API) | b (the hub collects inputs, hands off over SSO) |
# mock (in-memory, dev and e2e only; refused in production unless
# E2E_USE_MOCK_ADAPTERS=1). TOOL_HUB_MODE_<SLUG> for each tool:
# TOOL_HUB_MODE_CHALYBCLIP=off
# TOOL_HUB_MODE_CHALYBCRYPTO=off
# TOOL_HUB_MODE_CHALYBOBS=off
# TOOL_HUB_MODE_CHALYBBOT=off
# TOOL_HUB_MODE_CHALYBPICKS=off
# TOOL_HUB_MODE_CHALYBREALTOR=off
# TOOL_HUB_MODE_CHALYBTRADE=off

# Legal inboxes (old P6-8). ARCO requests (Aviso de privacidad §5,
# Law's [CORREO DE PRIVACIDAD]) and copyright notices (Uso aceptable §5,
# [CORREO DE DERECHOS DE AUTOR]). Unset: the contact inbox (RESEND_CONTACT_TO).
# LEGAL_PRIVACY_EMAIL=
# LEGAL_COPYRIGHT_EMAIL=
