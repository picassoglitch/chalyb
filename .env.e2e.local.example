# Copy to .env.e2e.local (gitignored) and fill in. Never commit real values.
E2E_BASE_URL=
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation
E2E_VERCEL_BYPASS=
E2E_FREE_EMAIL=
E2E_FREE_PASSWORD=
E2E_PRO_EMAIL=
E2E_PRO_PASSWORD=
E2E_VIP_EMAIL=
E2E_VIP_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Optional: E2E_TRIAL_*, E2E_PRO_ANNUAL_*, E2E_PAST_DUE_*, E2E_SMOKE_VIDEO_URL
# Set only against a preview with Mercado Pago sandbox:
E2E_ALLOW_MUTATIONS=
