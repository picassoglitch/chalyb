# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id = "chalyb"
region     = "us-central1"
domain     = "chalyb.com"

# From `gcloud billing accounts list`. Leave empty to skip the budget alert,
# but set it if you can — video egress is the one line item here that can run
# away unnoticed.
billing_account   = "" # e.g. "01ABCD-2345EF-6789GH"
budget_amount_usd = 50

budget_alert_emails = ["you@example.com"]

# Rendered clips are re-derivable; keeping them forever is pure cost.
media_retention_days = 30

# Leave false and put Cloudflare in front of the run.app URLs unless the
# domain is already verified for this account in Google Search Console.
enable_domain_mappings = false

# ADDING AN AGENT IS ONE ENTRY HERE. `{}` is a valid entry: it gives a public
# Cloud Run service that scales to zero, a service account, three secrets and
# a domain mapping. See docs/infra/adding-an-engine.md, or run
# `node scripts/new-engine.mjs <slug> "<Name>"` which prints the block to paste.
#
# The defaults in variables.tf already describe the three live engines, so
# this only needs overriding to pin images or add an agent.
