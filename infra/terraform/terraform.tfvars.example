#       sso_secret   = "CHALYB_SSO_SECRET"
#       database_url = "DATABASE_URL"
#     }
#     shared_secrets = { CHALYBCLIP_ZERNIO_API_KEY = "zernio-api-key" }
#     worker = {
#       env              = { CHALYBCLIP_ROLE = "worker" }
#       endpoint_env_var = "CHALYBCLIP_MODAL_PIPELINE_ENDPOINT_URL"
#     }
#     jobs = {
#       drive-poll = {
#         command  = ["chalybclip"]
#         args     = ["drive", "poll"]
#         schedule = "* * * * *"
#         paused   = true
#       }
#     }
#   }
#
#   chalybobs    = { display_name = "ChalyOBS",    secret_env_names = { admin_token = "CHALYBOBS_ADMIN_TOKEN", sso_secret = "CHALYBOBS_SSO_SECRET" } }
