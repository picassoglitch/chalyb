{
  "name": "chalyb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/legal-publish-gate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/ts-resolve.mjs --test \"tests/*.test.ts\"",
    "check:copy": "node scripts/check-hardcoded-copy.mjs",
    "legal:hash": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs scripts/hash-legal-docs.mjs",
    "test:legal": "node --experimental-strip-types --no-warnings --import ./tests/ts-resolve.mjs scripts/test-legal.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:copy && pnpm test:legal && pnpm test:migrations && pnpm build",
    "test:migrations": "node scripts/test-migrations.mjs",
    "e2e": "playwright test",
    "e2e:mock-supabase": "node e2e/mock-supabase/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:link": "supabase link --project-ref uqcbziwdgbnzehipzjxp",
    "db:push": "supabase db push",
    "db:new": "supabase migration new"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mercadopago": "^3.6.1",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
